# Production settings for docker-compose.prod.yml. Copy to .env.prod on the server
# (never commit it) and fill in the secrets. The api and db containers read this file
# directly (env_file), so the secrets never appear in the compose file.

# Guest session cookie key: openssl rand -hex 64
SESSION_KEY=
# Password for the stack's own Postgres (openssl rand -hex 24), and the API's URL for it
# with the same password in place of <password>.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://tse:<password>@db/tse

# Image tag loaded with `docker load` (the git short hash they were built from).
TSE_TAG=latest
TSE_DOMAIN=tse.roythan.de
SYMBOLS=AAPL,MSFT,GOOGL
RESET_AT=04:00
SANDBOX_MAX=
SANDBOX_IDLE_MINS=
RUST_LOG=server=info,actix_web=warn
