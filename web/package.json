{
  "name": "tse-web",
  "description": "Web UI for Thande Stonks Exchange",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build.types && npm run lint && npm run build.client && npm run build.server",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/static/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "dev": "vite --mode ssr",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "npm run build.client && npm run build.preview && vite preview",
    "test": "vitest run",
    "test.watch": "vitest",
    "typecheck": "tsc --noEmit",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.2",
    "@builder.io/qwik-city": "1.20.2",
    "@eslint/js": "9.39.5",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-qwik": "1.20.2",
    "globals": "16.5.0",
    "lightweight-charts": "5.2.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.11"
  }
}
