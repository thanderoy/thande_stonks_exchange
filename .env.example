POSTGRES_USER=exchange
POSTGRES_PASSWORD=exchange
POSTGRES_DB=exchange
DATABASE_URL=postgres://exchange:exchange@db/exchange

API_BIND_ADDR=0.0.0.0:8080
SYMBOLS=AAPL,MSFT,GOOGL
RUST_LOG=server=info

# Guest session cookie key: hex or base64, >= 64 bytes, e.g. `openssl rand -hex 64`.
# Leave empty to generate a random key per start (sessions won't survive restarts).
SESSION_KEY=
# Set to false only for plain-HTTP local testing; empty means Secure cookies.
COOKIE_SECURE=
# Comma-separated CIDRs of the reverse proxy, e.g. the compose network. Empty = trust no proxy.
TRUSTED_PROXY_CIDRS=

# In-process bots that keep the shared market trading. Empty intervals use the defaults
# (a tick every 2000 ms; pre-market symbols open after 30 s).
BOTS=true
BOT_INTERVAL_MS=
BOT_PRE_OPEN_SECS=
# Daily market reset, HH:MM in UTC. Empty = never (the WAL then grows without bound).
RESET_AT=04:00
